# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/ccms

# Generate unique, long random values for both secrets.
JWT_SECRET=replace_with_a_random_secret
JWT_EXPIRES_IN=1d

PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Use private values; never share these access codes.
STAFF_ACCESS_CODE=replace_with_a_private_staff_code
ADMIN_ACCESS_CODE=replace_with_a_private_admin_code

# Optional email delivery for password-reset and status emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Recommended for Render's free tier (SMTP ports are blocked there)
RESEND_API_KEY=
RESEND_FROM=
RESEND_TEST_TO=

# Optional: initial account created by `npm run seed`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Optional: allow public, on-demand demo accounts for disposable demo databases.
# Clicking a role's demo button creates that account if it does not exist.
ENABLE_DEMO_LOGINS=false
DEMO_APPLICANT_USERNAME=demo-applicant
DEMO_APPLICANT_PASSWORD=
DEMO_STAFF_USERNAME=demo-staff
DEMO_STAFF_PASSWORD=
DEMO_ADMIN_USERNAME=demo-admin
DEMO_ADMIN_PASSWORD=
