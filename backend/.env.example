# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/ccms

# Generate unique, long random values for both secrets.
JWT_SECRET=replace_with_a_random_secret
SESSION_SECRET=replace_with_a_different_random_secret
JWT_EXPIRES_IN=1d

PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Optional: omit both values to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Use private values; never share these access codes.
STAFF_ACCESS_CODE=replace_with_a_private_staff_code
ADMIN_ACCESS_CODE=replace_with_a_private_admin_code

# Required for verification and password-reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Recommended for Render's free tier (SMTP ports are blocked there)
RESEND_API_KEY=
RESEND_FROM=
RESEND_TEST_TO=

# Optional: initial account created by `npm run seed`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace_with_a_strong_password
